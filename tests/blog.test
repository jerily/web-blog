package require tcltest 2
namespace import ::tcltest::*
package require web-blog

proc setup_blog {} {
    set ::sourceDir [makeDirectory blog-source]
    foreach {name text} {2026-01-01-one.md {# One} 2026-02-01-two.md {# Two}} {
        set f [open [file join $::sourceDir $name] w]; puts $f $text; close $f
    }
    set ::db [::tpersist::db_connect -database :memory: -autobegin 0]
    ::web::blog::initdb $::db
    set ::blog [::web::blog::create -connection $::db]
    ::web::blog::sync $::blog $::sourceDir
    set ::router [::tpathexp::router]
    ::web::blog::mount $::router -store $::blog
}
proc cleanup_blog {} {
    $::router destroy
    ::tpersist::db_disconnect $::db
    removeDirectory $::sourceDir
}

test blog-1 {posts are listed newest first and domains stay independent} -setup setup_blog -body {
    set other [::web::blog::create -connection $db -domain other.test]
    ::web::blog::sync $other $sourceDir
    ::web::blog::save $other /2026-01-01-one Other Changed 1
    set titles {}
    foreach post [::web::blog::posts $blog] {lappend titles [dict get $post title]}
    list $titles [dict get [::web::blog::load $other /2026-01-01-one] title] \
        [dict get [::web::blog::load $blog /2026-01-01-one] title]
} -cleanup cleanup_blog -result {{Two One} Other One}

test blog-2 {blog index, post, and assets share mount conventions} -setup setup_blog -body {
    set body [dict get [$router dispatch {method GET path /blog}] body]
    list [expr {[string first /2026-02-01-two $body] < [string first /2026-01-01-one $body]}] \
        [dict get [$router dispatch {method GET path /blog/2026-01-01-one}] statusCode] \
        [dict get [$router dispatch {method HEAD path /blog/_assets/markdown-editor.bundle.js}] body]
} -cleanup cleanup_blog -result {1 200 {}}

test blog-3 {invalid dates abort import without hiding posts} -setup setup_blog -body {
    set f [open [file join $sourceDir 2026-02-30-bad.md] w]; puts $f {# Bad}; close $f
    catch {::web::blog::sync $blog $sourceDir} message options
    list [dict get $options -errorcode] [llength [::web::blog::posts $blog]]
} -cleanup cleanup_blog -result {{WEB BLOG 400} 2}

test blog-4 {removed posts disappear; edits preserve history} -setup setup_blog -body {
    ::web::blog::save $blog /2026-01-01-one One Revised 1
    file delete [file join $sourceDir 2026-02-01-two.md]
    ::web::blog::sync $blog $sourceDir
    list [llength [::web::blog::posts $blog]] [dict get [::web::blog::load $blog /2026-01-01-one] markdown] \
        [llength [::web::blog::history $blog /2026-01-01-one]]
} -cleanup cleanup_blog -result {1 Revised 2}

test blog-5 {headingless posts use the filename without duplicating its date} -setup setup_blog -body {
    set f [open [file join $sourceDir 2026-03-01-Release.MD] w]
    puts $f {A short release note.}; close $f
    ::web::blog::sync $blog $sourceDir
    dict get [::web::blog::load $blog /2026-03-01-release] title
} -cleanup cleanup_blog -result Release

test standalone-1 {package loads independently and creates only its own tables} -body {
    set connection [::tpersist::db_connect -database :memory: -autobegin 0]
    try {
        ::web::blog::initdb $connection
        ::web::blog::initdb $connection
        set tables {}
        foreach row [dict get [::tpersist::db_execute $connection [::tpersist::db_select sqlite_master -columns name]] rows] {
            if {[string match web_* [dict get $row name]]} {lappend tables [dict get $row name]}
        }
        list [package provide web-wiki] [namespace exists ::web::content] [lsort $tables]
    } finally {::tpersist::db_disconnect $connection}
} -result {{} 0 {web_blog_items web_blog_revisions}}

proc blog_authorize {request context action path} {dict exists $context editor}
proc blog_csrf {action request context token} {
    if {$action eq "issue"} {return test-token}
    expr {$token eq "test-token"}
}
proc blog_post {{csrf test-token}} {
    $::router dispatch [dict create method POST path /custom/_edit/2026-01-01-one \
        headers {content-type application/x-www-form-urlencoded} \
        body "title=Edited&markdown=Updated&revision=1&csrf=$csrf"] {editor 1}
}

test editor-1 {blog owns authorization, CSRF, revision checks and custom templates} -setup setup_blog -body {
    ::web::blog::mount $router -store $blog -prefix /custom -authorize blog_authorize -csrf blog_csrf \
        -config {master_template {<main data-host="blog">{% block body %}{% endblock %}</main>}}
    set statuses {}
    lappend statuses [dict get [$router dispatch {method GET path /custom/_edit/2026-01-01-one}] statusCode]
    foreach path {/custom /custom/2026-01-01-one /custom/_edit/2026-01-01-one} {
        set response [$router dispatch [dict create method GET path $path] {editor 1}]
        if {![string match {*data-host="blog"*} [dict get $response body]]} {error "missing master"}
        lappend statuses [dict get $response statusCode]
    }
    lappend statuses [dict get [blog_post wrong] statusCode] \
        [dict get [blog_post] statusCode] [dict get [blog_post] statusCode] \
        [dict get [::web::blog::load $blog /2026-01-01-one] markdown] \
        [llength [::web::blog::history $blog /2026-01-01-one]]
    set statuses
} -cleanup cleanup_blog -result {403 200 200 200 403 303 409 Updated 2}

test editor-2 {blog assets are local and reject traversal} -setup setup_blog -body {
    set response [$router dispatch {method GET path /blog/_assets/markdown-editor.bundle.js}]
    list [dict get $response statusCode] [expr {[string length [dict get $response body]] > 1000}] \
        [dict get [$router dispatch {method GET path /blog/%2e%2e}] statusCode] \
        [dict get [$router dispatch {method GET path /blog/_edit/2026-01-01-one}] statusCode]
} -cleanup cleanup_blog -result {200 1 400 404}

test editor-3 {title-only edits update the visible heading without changing the URL or Markdown} -setup setup_blog -body {
    ::web::blog::mount $router -store $blog -prefix /custom -authorize blog_authorize -csrf blog_csrf
    set original [::web::blog::load $blog /2026-01-01-one]
    set result [$router dispatch [dict create method POST path /custom/_edit/2026-01-01-one \
        headers {content-type application/x-www-form-urlencoded} \
        body {title=Renamed+%26+%3Ctitle%3E&markdown=%23+One%0A&revision=1&csrf=test-token}] {editor 1}]
    set item [::web::blog::load $blog /2026-01-01-one]
    set body [dict get [$router dispatch {method GET path /custom/2026-01-01-one}] body]
    set index [dict get [$router dispatch {method GET path /custom}] body]
    list [dict get $result statusCode] [dict get $result headers location] \
        [dict get $item path] [dict get $item title] [dict get $item revision] \
        [expr {[dict get $item markdown] eq [dict get $original markdown]}] \
        [string match {*<h1>Renamed &amp; &lt;title&gt;</h1>*} $body] \
        [string match {*<h1>One</h1>*} $body] \
        [string match {*href="/custom/2026-01-01-one"*<h2>Renamed &amp; &lt;title&gt;</h2>*} $index]
} -cleanup cleanup_blog -result {303 /custom/2026-01-01-one /2026-01-01-one {Renamed & <title>} 2 1 1 0 1}

test templates-title {only a leading Markdown H1 is replaced by the saved title} -setup setup_blog -body {
    set revision 1
    set results {}
    foreach markdown [list "# Old\n\n# Section\n\nBody.\n" \
            "Old\nheading\n===\n\n# Section\n\nBody.\n" "Paragraph.\n\n# Section\n\nBody.\n"] {
        ::web::blog::save $blog /2026-01-01-one Renamed $markdown $revision
        incr revision
        set body [dict get [$router dispatch {method GET path /blog/2026-01-01-one}] body]
        lappend results [regexp -all {<h1>} $body] \
            [string match {*<h1>Renamed</h1>*<h1>Section</h1>*<p>Body.</p>*} $body]
    }
    lappend results [string match {*<p>Paragraph.</p>*} $body]
} -cleanup cleanup_blog -result {2 1 2 1 2 1 1}


proc mount_creation_blog {{enabled true}} {
    ::web::blog::mount $::router -store $::blog -prefix /custom \
        -authorize ::blog_authorize -csrf ::blog_csrf -config [dict create allow_create $enabled]
}
proc post_creation_blog {{body {title=New+Page&markdown=%23+New+Page%0D%0A%0D%0ABrowser&csrf=test-token&published_at=2026-11-06}}} {
    $::router dispatch [dict create method POST path /custom/_new \
        headers {content-type application/x-www-form-urlencoded} body $body] {editor 1}
}

test creation-1 {new items require the feature flag and editor callbacks} -setup setup_blog -body {
    ::web::blog::mount $router -store $blog -prefix /readonly -config {allow_create true}
    mount_creation_blog false
    set statuses {}
    foreach prefix {/readonly /custom} {
        foreach method {GET POST} {
            lappend statuses [dict get [$router dispatch [dict create method $method path $prefix/_new] {editor 1}] statusCode]
        }
        lappend statuses [string match {*href="*/_new"*} [dict get [$router dispatch [dict create method GET path $prefix]] body]]
    }
    set statuses
} -cleanup cleanup_blog -result {404 404 0 404 404 0}

test creation-2 {authorized forms publish revision one, redirect and reject duplicates} -setup setup_blog -body {
    mount_creation_blog
    set denied [$router dispatch {method GET path /custom/_new}]
    set form [$router dispatch {method GET path /custom/_new} {editor 1}]
    set result [post_creation_blog]
    set item [::web::blog::load $blog /2026-11-06-new-page]
    list [dict get $denied statusCode] [dict get $form statusCode] \
        [string match {*markdown-editor.bundle.js*} [dict get $form body]] \
        [string match {*name="revision"*} [dict get $form body]] \
        [dict get $result statusCode] [dict get $result headers location] \
        [dict get $item revision] [dict get $item source_path] \
        [dict get $item markdown] [llength [::web::blog::history $blog /2026-11-06-new-page]] \
        [dict get [post_creation_blog] statusCode]
} -cleanup cleanup_blog -result [list 403 200 1 0 303 /custom/2026-11-06-new-page 1 {} "# New Page\n\nBrowser" 1 409]

test creation-3 {authorization, CSRF, malformed forms and metadata validation reject writes} -setup setup_blog -body {
    mount_creation_blog
    set result [list [dict get [$router dispatch {method POST path /custom/_new}] statusCode]]
    foreach body {
        {title=Denied&markdown=x&csrf=wrong&published_at=2026-11-06}
        {title=&markdown=x&csrf=test-token&published_at=2026-11-06}
        {title=x&title=y&markdown=x&csrf=test-token&published_at=2026-11-06}
        {title=x&csrf=test-token&published_at=2026-11-06}
        {title=%00&markdown=x&csrf=test-token&published_at=2026-11-06}
    } {lappend result [dict get [post_creation_blog $body] statusCode]}
    lappend result [llength [::web::blog::history $blog /2026-11-06-new-page]]
    set result
} -cleanup cleanup_blog -result {403 403 400 400 400 400 0}

test creation-4 {browser pages survive sync and remain isolated by domain} -setup setup_blog -body {
    ::web::blog::add $blog / {New Page} Browser 2026-11-06
    ::web::blog::sync $blog $sourceDir
    set other [::web::blog::create -connection $db -domain other.test]
    catch {::web::blog::load $other /2026-11-06-new-page} message options
    list [dict get [::web::blog::load $blog /2026-11-06-new-page] markdown] \
        [dict get $options -errorcode] [llength [::web::blog::history $blog /2026-11-06-new-page]]
} -cleanup cleanup_blog -result {Browser {WEB BLOG 404} 1}

test creation-5 {source collisions with browser content fail without replacing revisions} -setup setup_blog -body {
    ::web::blog::add $blog / {New Page} Browser 2026-11-06
    set channel [open [file join $sourceDir 2026-11-06-new.md] w]
    puts $channel {# New Page}; close $channel
    catch {::web::blog::sync $blog $sourceDir} message options
    list [dict get $options -errorcode] [dict get [::web::blog::load $blog /2026-11-06-new-page] markdown]
} -cleanup cleanup_blog -result {{WEB BLOG 409} Browser}

test creation-6 {post dates are validated and new posts participate in chronological ordering} -setup setup_blog -body {
    mount_creation_blog
    set statuses {}
    foreach date {2026-02-30 2026-13-01 26-01-01 {}} {
        lappend statuses [dict get [post_creation_blog "title=New&markdown=x&csrf=test-token&published_at=$date"] statusCode]
    }
    post_creation_blog
    set newest [lindex [::web::blog::posts $blog] 0]
    list $statuses [dict get $newest path] [dict get $newest published_at]
} -cleanup cleanup_blog -result {{400 400 400 400} /2026-11-06-new-page 2026-11-06}


proc host_properties {request context} {
    dict create show_edit_controls [list BOOL [dict exists $context member]] \
        host_label [list S [dict get $request path]]
}
test host-context-1 {per-request host properties, default compatibility and mount isolation} -setup setup_blog -body {
    ::web::blog::mount $router -store $blog -prefix /dynamic \
        -authorize blog_authorize -csrf blog_csrf -context host_properties \
        -config {allow_create true master_template {<header>{{ host_label }}</header>{% block body %}{% endblock %}}}
    ::web::blog::mount $router -store $blog -prefix /plain \
        -authorize blog_authorize -csrf blog_csrf -config {allow_create true}
    set result {}
    foreach context {{} {member yes} {}} {
        set body [dict get [$router dispatch {method GET path /dynamic/2026-01-01-one} $context] body]
        lappend result [expr {[string first {/dynamic/_edit} $body] >= 0}] \
            [expr {[string first {/dynamic/_new} $body] >= 0}] \
            [expr {[string first {<header>/dynamic/2026-01-01-one</header>} $body] >= 0}]
    }
    set body [dict get [$router dispatch {method GET path /plain/2026-01-01-one}] body]
    lappend result [expr {[string first {/plain/_edit} $body] >= 0}] \
        [expr {[string first {/plain/_new} $body] >= 0}] \
        [dict get [$router dispatch {method GET path /dynamic/_edit/2026-01-01-one}] statusCode]
    set result
} -cleanup cleanup_blog -result {0 0 1 1 1 1 0 0 1 1 1 403}

cleanupTests
