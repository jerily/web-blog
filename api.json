{
  "format": "ttrek-web-api/1",
  "package": "web-blog",
  "summary": "Mount editable blog content.",
  "mount": {
    "command": "::web::blog::mount",
    "prefix": {
      "option": "-prefix",
      "default": "/blog",
      "allowRoot": true
    },
    "docs": "MOUNTING.md"
  },
  "inputs": {},
  "router": {
    "engine": "tpathexp",
    "strict": true
  },
  "routerMiddleware": [],
  "routes": [
    {
      "id": "asset",
      "summary": "Serve a bundled asset.",
      "methods": [
        "GET"
      ],
      "path": "/_assets/:asset",
      "handler": [
        "::web::blog::dispatch",
        {
          "bind": "config"
        },
        "asset"
      ]
    },
    {
      "id": "new",
      "summary": "Create a page.",
      "methods": [
        "GET",
        "POST"
      ],
      "path": "/_new",
      "handler": [
        "::web::blog::dispatch",
        {
          "bind": "config"
        },
        "new"
      ]
    },
    {
      "id": "new.path",
      "summary": "Create a page at the specified path.",
      "methods": [
        "GET",
        "POST"
      ],
      "path": "/_new/:path(.*)",
      "handler": [
        "::web::blog::dispatch",
        {
          "bind": "config"
        },
        "new"
      ]
    },
    {
      "id": "edit",
      "summary": "Edit the specified page.",
      "methods": [
        "GET",
        "POST"
      ],
      "path": "/_edit/:path(.*)",
      "handler": [
        "::web::blog::dispatch",
        {
          "bind": "config"
        },
        "edit"
      ]
    },
    {
      "id": "index",
      "summary": "Render the index.",
      "methods": [
        "GET"
      ],
      "path": "",
      "handler": [
        "::web::blog::dispatch",
        {
          "bind": "config"
        },
        "view"
      ]
    },
    {
      "id": "index.slash",
      "summary": "Render the index at the trailing-slash URL of a non-root mount.",
      "methods": [
        "GET"
      ],
      "path": "/",
      "handler": [
        "::web::blog::dispatch",
        {
          "bind": "config"
        },
        "view"
      ]
    },
    {
      "id": "page",
      "summary": "Render the requested path.",
      "methods": [
        "GET"
      ],
      "path": "/:path(.*)",
      "handler": [
        "::web::blog::dispatch",
        {
          "bind": "config"
        },
        "view"
      ]
    }
  ]
}
